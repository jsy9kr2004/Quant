# ============================================================================
# 데이터 설정 (DATA Configuration)
# ============================================================================
DATA:
  # 처리할 연도 범위 (포괄적 학습을 위한 최대 히스토리)
  START_YEAR: 1996
  END_YEAR: 2025

  # 데이터 저장 경로 (하위 디렉토리가 자동 생성됨)
  ROOT_PATH: "./data"

  # FMP API 설정
  FMP_URL: https://financialmodelingprep.com
  EX_SYMBOL: AAPL  # URL 파싱용 예제 심볼 (보통 변경 불필요)
  TARGET_API_LIST: src/data_collector/target_api_list.csv

  # 데이터 수집
  GET_FMP: N  # Y = FMP에서 새 데이터 가져오기, N = 기존 데이터 사용
  MAKE_VIEW: N  # Y = 기존 데이터로 VIEW CSV 재생성 (GET_FMP=N일 때도 동작), N = 건너뛰기
  STORAGE_TYPE: PARQUET  # PARQUET (권장) 또는 DB

# ============================================================================
# 평가 설정 (EVALUATION Configuration - regressor & backtest 통합)
# ============================================================================
EVALUATION:
  # Walk-Forward 평가 활성화
  # Y = walk-forward 방식 (각 리밸런싱마다 재학습, 실전 백테스트)
  # N = 단순 train/test split (legacy, 빠른 실험용)
  USE_WALK_FORWARD: Y

  # 학습 데이터 시작 연도 (전체 히스토리)
  # Walk-Forward 시 이 연도부터 cutoff_date까지 expanding window로 학습
  TRAIN_START_YEAR: 1996

  # Walk-Forward 평가 구간 (여러 구간 지원)
  # 각 구간은 독립적으로 평가되며, 최종 레포트에 통합됨
  PERIODS:
    # 구간 1: 팬데믹 충격과 유동성 주도 장세
    - START_YEAR: 2020
      END_YEAR: 2021
      START_MONTH: 1
      START_DATE: 1

    # 구간 2: 금리 급등기와 AI 중심 회복 장세
    - START_YEAR: 2022
      END_YEAR: 2023
      START_MONTH: 1
      START_DATE: 1

  # 리밸런싱 주기 (개월)
  REBALANCE_PERIOD: 3  # 분기별 (3개월)

  # 선택할 종목 수 (포트폴리오 크기)
  TOP_K_NUM: 10

  # Walk-Forward 학습 윈도우 타입
  # "expanding": 시작~현재 (점점 증가, 권장)
  # "rolling": 최근 N년만 (고정 크기)
  WINDOW_TYPE: "expanding"

  # Rolling window 사용 시 윈도우 크기 (년)
  # WINDOW_TYPE="rolling"일 때만 적용
  WINDOW_SIZE: 3

  # 모델 재학습 빈도
  # "every": 매 리밸런싱마다 재학습 (가장 정확, 느림)
  # "quarterly": 분기마다 재학습 (권장)
  # "yearly": 연도마다 재학습
  # "once": 한 번만 학습 (빠름, 부정확)
  RETRAIN_FREQUENCY: "quarterly"

  # 예측 결과 캐시 파일 위치
  # regressor.py가 생성한 캐시를 ml_backtest.py가 사용 (일원화 원칙)
  # {ROOT_PATH}/MODELS/ 하위에 저장됨
  PREDICTIONS_CACHE_FILE: "regressor_predictions.pkl"

  # 병렬 학습 설정 (Parallel Training)
  # Walk-forward 구간별로 병렬 학습하여 속도 향상
  PARALLEL_TRAINING: Y  # Y = 병렬 학습, N = 순차 학습

  # 병렬 워커 수
  # "auto": 메모리 프로파일 기반 자동 결정 (권장)
  # 1-8: 지정된 워커 수 (수동 설정)
  NUM_WORKERS: "auto"

  # 메모리 프로파일 저장 위치
  # {ROOT_PATH}/config/ 하위에 저장됨
  # 자동으로 메모리 사용량을 학습하여 최적 워커 수 결정
  MEMORY_PROFILE_FILE: "memory_profile.json"

# ============================================================================
# 머신러닝 설정 (ML Configuration)
# ============================================================================
ML:
  # ML 학습 실행 여부
  RUN_REGRESSION: Y  # Y = 모델 학습, N = 건너뛰기

  # ⚠️  DEPRECATED: 아래 설정들은 EVALUATION 섹션으로 이동됨
  # TRAIN_START_YEAR, TRAIN_END_YEAR, TEST_START_YEAR, TEST_END_YEAR는
  # 더 이상 사용되지 않습니다. EVALUATION.PERIODS를 사용하세요.
  #
  # 하위 호환성을 위해 EVALUATION.USE_WALK_FORWARD=N인 경우에만 사용됨:
  # TRAIN_START_YEAR: 1996
  # TRAIN_END_YEAR: 2022
  # TEST_START_YEAR: 2023
  # TEST_END_YEAR: 2025

  # NaN 제거 진단 (초기 데이터 품질 확인용)
  EXPORT_NAN_REMOVAL_DETAILS: Y  # Y = 제거된 NaN 데이터를 CSV로 저장, N = 로그만 출력

  # 모델 선택 (신규 모델 vs 레거시 모델)
  USE_NEW_MODELS: N  # Y = 신규 CatBoost/MLflow 사용, N = 레거시 regressor.py 사용

  # 학습할 모델 목록 (USE_NEW_MODELS = Y일 때만)
  MODELS:
    - xgboost_default
    - xgboost_depth_9
    - xgboost_depth_10
    - lightgbm_default
    - catboost_default
    - catboost_deep

  # 하이퍼파라미터 최적화 (프로덕션 환경 권장)
  USE_OPTUNA: Y  # Y = 자동 하이퍼파라미터 튜닝으로 최적 성능 추구

  # ===== Classifier Optuna (전체 데이터로 최적화) =====
  # ===== Test Mode (빠른 동작 확인용 - 모델 성능보다 실행 가능 여부 테스트) =====
  OPTUNA_TRIALS: 3  # 빠른 테스트용 최소 trial 수
  OPTUNA_CV_FOLDS: 2  # 빠른 테스트용 최소 CV fold 수
  OPTUNA_TIMEOUT: 300  # 5분 제한

  # ===== Production Mode (실전 투자용 - 최고 성능 추구) =====
  # OPTUNA_TRIALS: 50  # 철저한 최적화 (권장)
  # OPTUNA_CV_FOLDS: 5  # 전체 교차 검증
  # OPTUNA_TIMEOUT: null  # 시간 제한 없음 (40-80시간 소요 가능)

  OPTUNA_SAVE_REPORT: Y  # Y = 상세 TXT/CSV/JSON 리포트 저장
  OPTUNA_SAVE_PLOTS: Y  # Y = PNG 시각화 차트 저장

  # Optuna 탐색 공간 (메모리 안전성 및 과적합 방지를 위해 업데이트됨)
  # 분석 결과: max_depth=8, n_estimators=500이 메모리 오류 방지
  OPTUNA_SEARCH_SPACE:
    n_estimators: [100, 500]  # 메모리 할당 오류 방지를 위해 제한
    learning_rate: [0.01, 0.3]  # 최소 0.01 (너무 느린 학습 방지)
    max_depth: [3, 8]  # 메모리 안전성 및 과적합 방지를 위해 8로 제한
    subsample: [0.5, 1.0]  # 행 샘플링 비율
    colsample_bytree: [0.5, 1.0]  # 열 샘플링 비율
    gamma: [0, 10]  # 분할을 위한 최소 손실 감소

  # ===== Sector-specific Optuna (섹터별 개별 최적화) =====
  OPTUNA_OPTIMIZE_SECTORS: Y  # Y = 각 섹터별로 개별 최적화, N = SECTOR_CONFIG만 사용
  OPTUNA_SECTOR_TRIALS: 30  # 섹터당 trial 수 (효율성을 위해 classifier보다 적게)
  OPTUNA_SECTOR_CV_FOLDS: 2  # 섹터 최적화용 CV fold 수
  OPTUNA_SECTOR_TIMEOUT: 180  # 섹터당 타임아웃 (테스트 모드에서 3분)

  # ===== Optuna 결과 재사용 (Result Reuse) =====
  OPTUNA_REUSE_EXISTING: Y  # Y = 기존 결과 재사용, N = 항상 재최적화
  OPTUNA_REUSE_MAX_AGE_DAYS: 0  # 0 = 무제한 재사용, >0 = 일수 제한

  # MLflow 실험 추적
  USE_MLFLOW: N  # Y = MLflow로 실험 추적
  MLFLOW_EXPERIMENT: quant_trading_v2

  # ML 후 종료 (백테스트 실행 안 함)
  EXIT_AFTER_ML: N  # Y = ML 후 종료, N = 백테스트 계속

  # ============================================================================
  # Model Architecture (모델 아키텍처)
  # ============================================================================
  # Classifier on/off (분류기 사용 여부)
  # Y = Train classifiers + regressors (default, enables wbinary/ensemble predictions)
  # N = Train regressors only (simpler, faster, no ensemble strategies)
  USE_CLASSIFIER: Y

  # ============================================================================
  # CatBoost 하이퍼파라미터 (CatBoost Hyperparameters)
  # ============================================================================
  # CatBoost 모델의 하이퍼파라미터를 외부에서 제어합니다.
  # model_factory.py에서 CatBoost 모델 생성 시 사용됩니다.
  # 섹터별 SECTOR_CONFIG의 learning_rate, max_depth, n_estimators가
  # 있으면 해당 값이 우선 적용됩니다.
  CATBOOST_CONFIG:
    # 공통 설정 (Classifier/Regressor 공통)
    l2_leaf_reg: 5.0         # L2 정규화 계수
    rsm: 0.8                 # 컬럼 서브샘플링 비율 (CPU 모드)
    learning_rate: 0.05      # 학습률

    # Classifier 전용
    CLASSIFIER:
      iterations: 800        # 글로벌 Classifier 부스팅 라운드 수
      depth: 7               # 트리 깊이
      sector_iterations: 600 # 섹터별 Classifier 부스팅 라운드 수

    # Regressor 전용
    REGRESSOR:
      iterations: 1200       # 글로벌 Regressor 부스팅 라운드 수
      depth: 7               # 트리 깊이
      sector_iterations: 900 # 섹터별 Regressor 부스팅 라운드 수

  # ============================================================================
  # 분류기 모드 설정 (Classifier Mode Configuration)
  # ============================================================================
  # Classifier의 학습 목표를 정의

  # CLASSIFIER_MODE 옵션:
  # - "negative_screen": 명백히 나쁜 종목을 식별 (하위 n% 제거)
  #   → 목표: "이 재무제표는 무조건 떨어진다" 종목 걸러내기
  #   → Conservative 전략: 나쁜 거 피하기
  #   → 학습 데이터: 하위 n% 제거 후 나머지 80~95%로 회귀 학습
  #
  # - "positive_screen": 좋은 종목을 식별 (상위 n% 선택)
  #   → 목표: "이 재무제표는 무조건 오른다" 종목 찾기
  #   → Aggressive 전략: 좋은 거 찾기
  #   → 학습 데이터: 상위 n% 선택해서 회귀 학습
  CLASSIFIER_MODE: "negative_screen"  # "negative_screen" or "positive_screen"

  # Negative Screening 설정 (CLASSIFIER_MODE = "negative_screen"일 때)
  NEGATIVE_SCREEN:
    # 절대 손실 threshold: 이 값 이하면 "명백히 나쁜" 종목으로 간주
    # 예: -0.3 = 30% 이상 손실
    #     -0.4 = 40% 이상 손실
    #     -0.5 = 50% 이상 손실
    LOSS_THRESHOLD: -0.3  # 기본값: -30% 이상 손실 = BAD

    # Threshold 후보 자동 탐색 (로그 출력용)
    # 학습 시 여러 threshold 후보의 분포를 출력하여 적절한 값 찾기
    ANALYZE_THRESHOLDS: Y  # Y = 분포 분석 출력, N = 건너뛰기
    THRESHOLD_CANDIDATES:  # 탐색할 threshold 후보들
      - -0.2  # 20% 손실
      - -0.3  # 30% 손실
      - -0.4  # 40% 손실
      - -0.5  # 50% 손실

  # ============================================================================
  # 분류기 필터링 설정 (Classifier Filtering Configuration)
  # ============================================================================
  # Stage 1: 위험한/약한 종목을 제거하여 Stage 2 회귀기에게 전달할 종목 결정

  # 자동 임계값 최적화 (권장)
  CLASSIFIER_THRESHOLD_AUTO_SEARCH: Y  # Y = 최적 제거 비율 자동 탐색, N = 고정값 사용

  # 고정 제거 비율 (AUTO_SEARCH = N일 때만 사용)
  CLASSIFIER_REMOVE_PCT: 8  # 8% 제거 (92% 유지)

  # 자동 탐색 범위 - 제거할 종목 비율 (%)
  CLASSIFIER_REMOVE_PCT_MIN: 2   # 최소 2% 제거 (98% 유지) - 보수적
  CLASSIFIER_REMOVE_PCT_MAX: 15  # 최대 15% 제거 (85% 유지) - 공격적

  # 최적 비율 선택 기준
  CLASSIFIER_THRESHOLD_MIN_PRECISION: 0.65  # 필요한 최소 precision (65%)
  CLASSIFIER_THRESHOLD_MIN_SAMPLES: 30      # 제거 후 최소 종목 수
  CLASSIFIER_THRESHOLD_STRATEGY: "balance"  # "precision" (최대 정확도) 또는 "balance" (정확도 + 데이터 크기)

  # 자동 탐색 작동 방식:
  # 1. 모든 데이터로 분류기 학습
  # 2. 제거 비율 2~15%를 테스트하여 최적 지점 찾기
  #    - negative_screen: BAD 확률 상위 N% 제거
  #    - positive_screen: GOOD 확률 하위 N% 제거
  # 3. min_precision을 만족하면서 최대 데이터를 가진 비율 선택 (balance 모드)
  #    또는 가장 높은 precision을 가진 비율 선택 (precision 모드)
  # 4. 최적 비율로 종목을 필터링한 후 회귀기 학습
  # 5. 일관된 평가를 위해 모델과 함께 임계값 설정 저장
  #
  # 예시:
  #   학습 데이터 10,000개, REMOVE_PCT_MIN=2, REMOVE_PCT_MAX=15
  #   - 2% 제거: 9,800개로 회귀 학습
  #   - 15% 제거: 8,500개로 회귀 학습
  #   → balance 모드: precision 65% 이상 중 데이터 최대인 비율 선택

  # ============================================================================
  # 섹터별 모델 학습 (Sector-based Model Training)
  # ============================================================================
  # Y = 섹터별로 독립적인 모델 학습 (각 섹터가 자체 분류기 + 회귀기 보유)
  # N = 전체 종목에 대한 글로벌 모델 학습 (하나의 분류기 + 회귀기 세트)
  #
  # USE_SECTOR_MODEL: Y and USE_CLASSIFIER: Y인 경우
  #   → 각 섹터: 4 분류기 + 2 회귀기 (완전 독립)
  # USE_SECTOR_MODEL: Y and USE_CLASSIFIER: N인 경우
  #   → 각 섹터: 2 회귀기만
  # USE_SECTOR_MODEL: N and USE_CLASSIFIER: Y인 경우
  #   → 글로벌: 4 분류기 + 2 회귀기
  # USE_SECTOR_MODEL: N and USE_CLASSIFIER: N인 경우
  #   → 글로벌: 2 회귀기만
  USE_SECTOR_MODEL: Y

  # 섹터 카테고리화 설정 (작은 섹터들을 통합하여 샘플 수 부족 문제 해결)
  SECTOR_CATEGORIZATION:
    ENABLED: Y  # Y = 카테고리 통합 (권장), N = 원본 섹터 사용

    # 카테고리 정의 (경제적 특성 기반)
    CATEGORIES:
      # 1. 금융 (이자율/신용 민감 섹터)
      Financial:
        sectors:
          - Financials
          - Real Estate
        description: "이자율 및 신용 주기에 민감한 금융 관련 섹터"
        # 카테고리별 모델 설정 (ENABLED=Y일 때만 적용)
        model_config:
          model: xgboost
          n_estimators: 200
          max_depth: 7
          learning_rate: 0.05

      # 2. 기술 (성장주, 고밸류에이션 섹터)
      Technology:
        sectors:
          - Information Technology
          - Communication Services
        description: "혁신 중심의 고성장 기술 기업"
        model_config:
          model: xgboost
          n_estimators: 250
          max_depth: 8
          learning_rate: 0.08

      # 3. 필수소비재 (경기방어 섹터)
      Defensive:
        sectors:
          - Consumer Staples
          - Utilities
          - Healthcare
        description: "경기 침체에도 안정적인 수요를 유지하는 방어적 섹터"
        model_config:
          model: xgboost
          n_estimators: 150
          max_depth: 6
          learning_rate: 0.05

      # 4. 경기민감 (경기순환 섹터)
      Cyclical:
        sectors:
          - Industrials
          - Materials
          - Energy
          - Consumer Discretionary
        description: "경기 변동에 민감하게 반응하는 순환적 섹터"
        model_config:
          model: xgboost
          n_estimators: 200
          max_depth: 7
          learning_rate: 0.1

      # 5. 기타 (명시되지 않은 작은 섹터들)
      # Others 카테고리는 자동 생성됨 (위 카테고리에 포함되지 않은 모든 섹터)
      # 예: Conglomerates 등
      Others:
        # sectors는 자동 할당 (위에 정의되지 않은 모든 섹터)
        description: "기타 분류되지 않은 섹터"
        model_config:
          model: xgboost
          n_estimators: 150
          max_depth: 6
          learning_rate: 0.1

    # 최소 샘플 수 및 Fallback 전략
    MIN_SAMPLES_PER_CATEGORY: 1000
    FALLBACK_STRATEGY: "unified"  # unified: 전체 데이터 모델 사용 | skip: 예측 제외

# ============================================================================
# 예측 전용 모드 (PREDICTION Configuration - Inference Only)
# ============================================================================
# 이미 학습된 모델을 사용하여 특정 날짜 기준으로 주식 추천만 수행합니다.
# 학습(train), 평가(evaluation), 백테스트(backtest)를 건너뛰고 빠르게 추천을 받을 수 있습니다.
#
# 사용 시나리오:
# 1. 모델 학습 완료 후, 매일/매주 최신 데이터로 추천만 받고 싶을 때
# 2. 특정 과거 날짜 기준으로 "그때 뭘 샀어야 했나?" 확인하고 싶을 때
# 3. FMP 데이터 업데이트 후 빠르게 추천 확인하고 싶을 때
#
# 전제 조건:
# - MODELS/ 디렉토리에 학습된 모델이 있어야 함 (clsmodel_*.sav, model_*.sav 등)
# - processed/ml_data/per_year/에 TARGET_DATE 이전 데이터가 있어야 함
#
PREDICTION:
  # 예측 전용 모드 활성화
  # Y = 학습/평가/백테스트 건너뛰고 예측만 수행
  # N = 기존 파이프라인 (학습 → 평가 → 백테스트)
  ENABLED: N

  # 예측 기준 날짜
  # - 특정 날짜: "2025-01-11" (이 날짜 기준으로 사용 가능한 최신 데이터로 예측)
  # - 최신 데이터: "latest" (parquet 파일의 가장 최근 데이터 사용)
  TARGET_DATE: "latest"

  # 추천 종목 수 (Top-K)
  TOP_K: 10

# ============================================================================
# 백테스트 설정 (BACKTEST Configuration - ML Walk-Forward)
# ============================================================================
BACKTEST:
  # 백테스트 실행 여부
  RUN_BACKTEST: Y  # Y = 백테스트 실행, N = 건너뛰기

  # ⚠️  DEPRECATED: PERIODS, REBALANCE_PERIOD, TOP_K_NUM은 EVALUATION 섹션으로 이동됨
  # 백테스트 구간 및 설정은 EVALUATION 섹션에서 통합 관리됩니다:
  # - EVALUATION.PERIODS: 백테스트 구간
  # - EVALUATION.REBALANCE_PERIOD: 리밸런싱 주기
  # - EVALUATION.TOP_K_NUM: 선택 종목 수
  #
  # 하위 호환성을 위해 EVALUATION 섹션이 없으면 아래 설정 사용:
  # PERIODS: [...]
  # REBALANCE_PERIOD: 3
  # TOP_K_NUM: 10

  # 거래 비용 설정 (Trading Costs)
  # --------------------------------
  # 실전과 동일한 조건으로 백테스트하기 위해 거래 비용을 반영합니다.
  #
  # COMMISSION: 거래 수수료 (편도, %)
  #   - 0.0: 무료 (대부분의 미국 브로커: Robinhood, Webull, Schwab 등)
  #   - 0.001 (0.1%): 보수적 추정치 (한국 등 수수료 있는 시장)
  #   - 0.0005 (0.05%): 일반적인 할인 브로커
  #
  # SLIPPAGE: 슬리피지 (편도, %)
  #   - 체결 시 예상 가격과 실제 체결 가격의 차이
  #   - 대형주: 0.0005 ~ 0.001 (0.05% ~ 0.1%)
  #   - 중소형주: 0.001 ~ 0.003 (0.1% ~ 0.3%)
  #   - 유동성 낮은 종목: 0.005+ (0.5%+)
  #
  # 예시 계산:
  #   매수 가격: $100.00 * (1 + 0.001) = $100.10 (슬리피지로 인해 비싸게 매수)
  #   매도 가격: $110.00 * (1 - 0.001) = $109.89 (슬리피지로 인해 싸게 매도)
  #   거래 비용: 0.001 * 2 = 0.2% (매수 + 매도)
  #   총 비용: 약 0.4% (슬리피지 0.2% + 수수료 0.2%)
  TRADING_COSTS:
    ENABLED: Y           # Y = 거래 비용 반영, N = 순수 수익률
    COMMISSION: 0.001    # 0.1% 편도 (왕복 0.2%)
    SLIPPAGE: 0.001      # 0.1% 편도 (왕복 0.2%)

  # 생성할 리포트 목록
  REPORT_LIST:
    - EVAL  # 평가 리포트
    - RANK  # 종목 순위 리포트
    - AI    # AI 예측 리포트

# ============================================================================
# 벤치마크 설정 (BENCHMARK Configuration)
# ============================================================================
BENCHMARK:
  # 벤치마크 비교 활성화 여부
  ENABLED: Y  # Y = 벤치마크 계산 및 레포트 생성, N = 건너뛰기

  # 비교할 벤치마크 심볼 리스트
  # 주의: 심볼 오타나 가격 데이터 없는 경우 자동 스킵됩니다
  SYMBOLS:
    - AAPL  # Apple Inc. - 대형주 대표
    - NVDA  # Nvidia Corp. - 성장주 대표
    - QQQ   # Invesco QQQ ETF - Nasdaq-100 추종 (기술주 중심)
    - SPY   # SPDR S&P 500 ETF - S&P 500 추종 (시장 전체)

  # 추가 가능한 벤치마크 예시 (필요시 주석 해제):
  # - MSFT  # Microsoft
  # - GOOGL # Alphabet (Google)
  # - IWM   # Russell 2000 ETF (소형주)
  # - DIA   # Dow Jones ETF
  # - VTI   # Total Stock Market ETF

# ============================================================================
# 피처 엔지니어링 설정 (FEATURE ENGINEERING Configuration)
# ============================================================================
FEATURES:
  # 최소 거래량 필터링 (백분위수) - 비유동성 종목 제거
  # 참고: 연도별로 계산되므로 시장 상황(M2, 인플레이션)에 자동 적응
  # 10 = 하위 10% 제거 (매우 보수적, 극단적 비유동성만 제거)
  # 20 = 하위 20% 제거 (보수적)
  # 50 = 하위 50% 제거 (너무 공격적, 비권장)
  MIN_VOLUME_PERCENTILE: 10

  # 극단적 수익률 필터링 - 뉴스/이벤트 기반 급등락 종목 제거
  # 철학: 극단적 수익률은 뉴스/심리 기반이지 펀더멘털 기반이 아니므로 학습에서 제외
  # 주의: 학습 데이터 생성 시에만 적용, 예측/백테스트 시에는 적용 안 함
  FILTER_EXTREME_MOVERS: Y  # Y = 학습 시 극단값 제거, N = 모두 유지
  EXTREME_FILTER_METHOD: robust_zscore  # 'robust_zscore' (권장), 'zscore', 'percentile'
  EXTREME_FILTER_THRESHOLD: 3.0  # z-score 기준: ±3.0σ (±3σ ≈ 99.7%), percentile 기준: 0.025 (2.5%)

  # 방법 설명:
  # - robust_zscore: 중앙값/MAD 사용 (이상치에 강건, 변동성 체제에 적응) - 권장
  # - zscore: 평균/표준편차 사용 (이상치에 민감, 하지만 단순)
  # - percentile: 지정된 백분위수에서 하드 컷 (단순하지만 변동성에 적응 안 함)

  # 피처 선택 임계값
  MISSING_THRESHOLD: 0.8  # 80% 이상 결측치인 컬럼 제거
  SAME_VALUE_THRESHOLD: 0.95  # 95% 이상 동일한 값인 컬럼 제거

  # 전처리 플래그 (regressor와 ml_backtest에 일관되게 적용)
  USE_WINSORIZATION: Y  # Y = 이상치 처리를 위한 winsorization 적용
  USE_FEATURE_SELECTION: Y  # Y = 저품질 피처 제거를 위한 피처 선택 적용

# ============================================================================
# 데이터 품질 검증 (DATA QUALITY Validation)
# ============================================================================
# NaN/Infinite 제거 효과 검증 및 데이터 품질 리포트 생성
#
# 배경:
# - NaN/Infinite 제거 로직은 존재하지만 실제 효과가 검증되지 않음
# - 제거율이 5%인지 50%인지에 따라 전략이 달라져야 함
# - A/B 테스트로 제거 vs 대체(imputation) 효과 비교 필요
#
DATA_QUALITY:
  # 데이터 품질 리포트 생성
  GENERATE_REPORT: Y  # Y = 학습 전 품질 리포트 자동 생성
  REPORT_OUTPUT_PATH: "outputs/data_quality_report.xlsx"  # 리포트 저장 경로

  # A/B 테스트: 데이터 클리닝 효과 검증
  # 주의: 활성화하면 학습 시간이 약간 증가 (데이터 처리 2회)
  VALIDATE_CLEANING_EFFECT: N  # Y = A/B 테스트 실행, N = 스킵

  # 클리닝 전략 (A/B 테스트 결과에 따라 조정)
  # - removal: 현재 방식 (NaN/Inf 행 제거)
  # - imputation: 대체 방식 (NaN/Inf를 median/0으로 대체)
  CLEANING_STRATEGY: removal

  # NaN 처리 세부 설정
  NAN_HANDLING:
    # 행 제거 기준: 이 비율 이상 NaN인 행 제거
    ROW_NAN_THRESHOLD: 0.5  # 50% 이상 NaN인 행 제거
    # 열 제거 기준: 이 비율 이상 NaN인 열 제거
    COL_NAN_THRESHOLD: 0.5  # 50% 이상 NaN인 열 제거
    # imputation 방식 선택 (CLEANING_STRATEGY=imputation일 때)
    IMPUTATION_METHOD: median  # median, mean, zero

  # 로깅 수준
  VERBOSE_LOGGING: Y  # Y = 상세 로그 (제거 통계 등), N = 요약만

# ============================================================================
# 일반 설정 (GENERAL Configuration)
# ============================================================================
# 로깅 레벨 (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR)
LOG_LVL: 20

# ============================================================================
# 리밸런싱 시작일 (LEGACY COMPATIBILITY)
# ============================================================================
# 일부 레거시 코드(`src/backtest/backtest.py`)와 ML 데이터 생성(`src/training/make_mldata.py`)에서
# 최상위 START_MONTH/START_DATE를 리밸런싱 "앵커"로 사용합니다.
#
# 예: REBALANCE_PERIOD=3, START_MONTH=3, START_DATE=17
#  → 매년 3/17, 6/17, 9/17, 12/17(휴장 시 근처 거래일로 보정)
START_MONTH: 3
START_DATE: 17

# ============================================================================
# 주요 워크플로우 (Common Workflows)
# ============================================================================
# 데이터 수집: DATA.GET_FMP=Y, ML.RUN_REGRESSION=N, BACKTEST.RUN_BACKTEST=N
# ML 학습: DATA.GET_FMP=N, ML.RUN_REGRESSION=Y, ML.EXIT_AFTER_ML=Y
# 백테스트: DATA.GET_FMP=N, ML.RUN_REGRESSION=N, BACKTEST.RUN_BACKTEST=Y
# 전체 파이프라인: 모두 Y, EXIT_AFTER_ML=N

# ============================================================================
# 실험 추적 설정 (EXPERIMENT TRACKING Configuration)
# ============================================================================
EXPERIMENT_TRACKING:
  # 마스터 스위치 - 전체 실험 추적 활성화 여부
  # 상세 가이드: docs/experiment_tracking_guide.md
  ENABLED: Y  # Y = 구글 시트/드라이브에 자동 업로드, N = 비활성화

  # 업로드 조건
  UPLOAD_CONDITIONS:
    # Master 브랜치만 업로드 (Feature 브랜치 실험은 로컬에만 기록)
    ONLY_MASTER_BRANCH: Y  # Y = master만, N = 모든 브랜치

    # 백테스트 결과 필수 (백테스트 없으면 업로드 스킵)
    REQUIRE_BACKTEST_RESULTS: Y  # Y = 백테스트 완료 시에만 업로드

  # Google Sheets 설정
  GOOGLE_SHEETS:
    SHEET_NAME: "Experiments"  # 시트 내 탭 이름
    RETRY_ON_FAILURE: 3  # API 실패 시 재시도 횟수
    TIMEOUT_SECONDS: 30  # API 타임아웃 (초)

  # GitHub Gist 설정 (Config 파일 저장용)
  # Google Drive 대신 GitHub Gist 사용 (무료, Service Account 제한 없음)
  GITHUB_GIST:
    CONFIG_PREFIX: "config_"  # 예: config_2025-12-30_baseline.yaml
    PUBLIC: N  # Y = 공개 Gist, N = Secret Gist (URL 아는 사람만 접근)

  # 민감 정보 마스킹 (Config 업로드 전 자동 처리)
  # Gist에 올라가는 Config에서 아래 키들이 "***MASKED***"로 변경됨
  MASK_KEYS:
    - API_KEY
    - GOOGLE_SHEETS_ID
    - GOOGLE_DRIVE_FOLDER_ID
    - GOOGLE_SERVICE_ACCOUNT_KEY_PATH
