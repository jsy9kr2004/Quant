# ============================================================================
# 민감 정보 설정 (Secrets Configuration)
# ============================================================================
# 이 파일을 secrets.yaml로 복사한 후 실제 값을 입력하세요.
#
# 주의사항:
# - 이 파일(secrets.yaml)은 절대 Git에 커밋하지 마세요!
# - .gitignore에 등록되어 있지만, 실수 방지를 위해 항상 확인하세요.
# - 팀원과 공유할 때는 secrets.yaml.template만 공유하세요.
#
# 사용법:
#   cp config/secrets.yaml.template config/secrets.yaml
#   # secrets.yaml을 편집하여 실제 값 입력
# ============================================================================

# ============================================================================
# FMP API 설정 (Financial Modeling Prep)
# ============================================================================
# FMP API 키를 https://site.financialmodelingprep.com/ 에서 발급받으세요.
# 무료 플랜: 분당 250 요청, 일부 API 제한
# 유료 플랜: 더 많은 요청 및 전체 API 접근
FMP_API_KEY: "YOUR_FMP_API_KEY_HERE"

# ============================================================================
# Google Cloud 설정 (Google Sheets 실험 결과 기록용)
# ============================================================================
# Google Cloud Console에서 Service Account를 생성하고 JSON 키를 다운로드하세요.
# 1. https://console.cloud.google.com/ 접속
# 2. IAM & Admin > Service Accounts > Create Service Account
# 3. JSON 키 생성 및 다운로드
# 4. 아래 경로에 저장 (또는 원하는 경로로 변경)

# Service Account JSON 키 파일 경로
# 주의: 이 파일도 Git에 커밋하면 안 됩니다!
GOOGLE_SERVICE_ACCOUNT_KEY_PATH: "~/.credentials/quant_sheets.json"

# Google Sheets ID (URL에서 확인: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit)
GOOGLE_SHEETS_ID: "YOUR_GOOGLE_SHEET_ID_HERE"

# ============================================================================
# GitHub 설정 (Config 파일을 Gist에 저장)
# ============================================================================
# GitHub Personal Access Token (PAT) - Gist 생성 권한 필요
# 발급 방법:
# 1. GitHub Settings > Developer settings > Personal access tokens
# 2. "Generate new token (classic)" 클릭
# 3. "gist" 스코프만 선택하여 토큰 생성
# 4. 생성된 토큰을 아래에 입력
GITHUB_PAT: "YOUR_GITHUB_PAT_HERE"

# ============================================================================
# MLflow 서버 설정 (선택사항)
# ============================================================================
# 내부 MLflow 서버를 사용하는 경우에만 설정
# 로컬 MLflow 사용 시 null로 유지
MLFLOW_TRACKING_URI: null  # 예: "http://your-mlflow-server:5000"

# ============================================================================
# 데이터베이스 설정 (선택사항, 미래 확장용)
# ============================================================================
# DATABASE_HOST: "localhost"
# DATABASE_PORT: 5432
# DATABASE_USER: "your_username"
# DATABASE_PASSWORD: "YOUR_DATABASE_PASSWORD_HERE"
# DATABASE_NAME: "quant_db"

# ============================================================================
# AWS 설정 (선택사항, 미래 확장용)
# ============================================================================
# AWS_ACCESS_KEY_ID: "YOUR_AWS_ACCESS_KEY_HERE"
# AWS_SECRET_ACCESS_KEY: "YOUR_AWS_SECRET_KEY_HERE"
# AWS_REGION: "us-east-1"

# ============================================================================
# OpenAI API 설정 (선택사항, AI 분석용)
# ============================================================================
# OPENAI_API_KEY: "YOUR_OPENAI_API_KEY_HERE"
