# Quant Trading System Configuration Template
# Copy this file to conf.yaml and fill in your settings

# ============================================================================
# DATA Configuration
# ============================================================================
DATA:
  # Years to process
  START_YEAR: 2015
  END_YEAR: 2023

  # Data root path (will create subdirectories here)
  ROOT_PATH: /home/user/Quant/data

  # FMP API settings
  FMP_URL: https://financialmodelingprep.com
  API_KEY: YOUR_FMP_API_KEY_HERE  # Get from https://site.financialmodelingprep.com/
  EX_SYMBOL: AAPL  # Example symbol used for URL parsing (usually don't need to change)
  TARGET_STOCK_LIST: /home/user/Quant/stocks.csv
  TARGET_API_LIST: data_collector/target_api_list.csv

  # Data collection
  GET_FMP: N  # Y = Fetch new data from FMP, N = Use existing data
  MAKE_VIEW: N  # Y = Rebuild VIEW CSVs from existing data (works even when GET_FMP=N), N = Skip
  STORAGE_TYPE: PARQUET  # PARQUET (recommended) or DB

  # Debug mode: Save CSV files alongside Parquet for inspection
  SAVE_DEBUG_CSV: N  # Y = Save both Parquet and CSV, N = Parquet only (recommended for performance)

# ============================================================================
# ML Configuration
# ============================================================================
ML:
  # Enable ML training
  RUN_REGRESSION: Y  # Y = Train models, N = Skip

  # Training/test split by year
  TRAIN_START_YEAR: 2015
  TRAIN_END_YEAR: 2021
  TEST_START_YEAR: 2022
  TEST_END_YEAR: 2023

  # NaN removal diagnostics (초기 데이터 품질 확인용)
  EXPORT_NAN_REMOVAL_DETAILS: Y  # Y = 제거된 NaN 데이터를 CSV로 저장, N = 로그만 출력

  # Model selection (use new models or legacy)
  USE_NEW_MODELS: N  # Y = Use new CatBoost/MLflow, N = Use legacy regressor.py

  # Models to train (if USE_NEW_MODELS = Y)
  MODELS:
    - xgboost_default
    - xgboost_depth_9
    - xgboost_depth_10
    - lightgbm_default
    - catboost_default
    - catboost_deep

  # Ensemble
  USE_ENSEMBLE: N  # Y = Use stacking ensemble
  ENSEMBLE_TYPE: stacking  # stacking or voting

  # Hyperparameter optimization
  USE_OPTUNA: N  # Y = Auto-tune hyperparameters (takes time)
  OPTUNA_TRIALS: 50
  OPTUNA_CV_FOLDS: 5

  # MLflow experiment tracking
  USE_MLFLOW: N  # Y = Track experiments with MLflow
  MLFLOW_EXPERIMENT: quant_trading_v2
  MLFLOW_TRACKING_URI: null  # null for local, or http://server:5000

  # Exit after ML (don't run backtest)
  EXIT_AFTER_ML: Y  # Y = Exit after ML, N = Continue to backtest

  # ============================================================================
  # Sector-based Model Training (섹터별 모델 학습)
  # ============================================================================
  USE_SECTOR_MODEL: N  # Y = Train separate models per sector, N = Train unified model (default)

  # Sector configuration (only used if USE_SECTOR_MODEL = Y)
  SECTOR_CONFIG:
    # Default: Use same model for all sectors (XGBoost)
    # Advanced: Customize model per sector for better performance

    # Example 1: Same model, different parameters per sector
    Technology:
      model: xgboost  # xgboost, lightgbm, catboost
      n_estimators: 200
      max_depth: 8
      learning_rate: 0.05

    Financial:
      model: xgboost
      n_estimators: 150
      max_depth: 6
      learning_rate: 0.1

    Healthcare:
      model: xgboost
      n_estimators: 200
      max_depth: 7
      learning_rate: 0.05

    Consumer:
      model: xgboost
      n_estimators: 150
      max_depth: 6
      learning_rate: 0.1

    Industrial:
      model: xgboost
      n_estimators: 150
      max_depth: 6
      learning_rate: 0.1

    # Example 2: Different models per sector (uncomment to use)
    # Technology:
    #   model: xgboost
    #   n_estimators: 200
    #   max_depth: 8
    #
    # Financial:
    #   model: lightgbm
    #   n_estimators: 150
    #   num_leaves: 31
    #
    # Healthcare:
    #   model: catboost
    #   iterations: 200
    #   depth: 7

# ============================================================================
# BACKTEST Configuration (ML Walk-Forward 백테스트)
# ============================================================================
BACKTEST:
  # Run backtesting
  RUN_BACKTEST: Y  # Y = Run backtest, N = Skip

  # ===== 옵션 1: 여러 구간 백테스트 (권장) =====
  # 서로 다른 시기의 성과를 별도로 측정 (예: 금융위기 vs 호황기)
  PERIODS:
    # 구간 1: 2023년
    - START_YEAR: 2023
      END_YEAR: 2023
      START_MONTH: 3
      START_DATE: 13

    # 구간 2: 2024년
    - START_YEAR: 2024
      END_YEAR: 2024
      START_MONTH: 3
      START_DATE: 13

    # 추가 예시: 금융위기와 호황기 비교
    # - START_YEAR: 2008
    #   END_YEAR: 2009
    # - START_YEAR: 2020
    #   END_YEAR: 2021

  # ===== 옵션 2: 단일 구간 백테스트 =====
  # PERIODS를 주석 처리하고 아래 사용
  # START_YEAR: 2023
  # END_YEAR: 2024
  # START_MONTH: 3
  # START_DATE: 13

  # 공통 설정
  REBALANCE_PERIOD: 3  # 리밸런싱 주기 (개월)
  TOP_K_NUM: 20        # 선택할 종목 수
  MEMBER_CNT: 20       # 실제 매수 종목 수
  ABSOLUTE_SCORE: 500
  TOTAL_ASSET: 100000

  # Reports to generate
  REPORT_LIST:
    - EVAL
    - RANK
    - AI

# ============================================================================
# FEATURE ENGINEERING Configuration
# ============================================================================
FEATURES:
  # Minimum trading volume (percentile)
  MIN_VOLUME_PERCENTILE: 50

  # Time series window
  TS_WINDOW: 12  # quarters

  # Feature selection thresholds
  MISSING_THRESHOLD: 0.8  # Remove columns with > 80% missing
  SAME_VALUE_THRESHOLD: 0.95  # Remove columns with > 95% same value
  ROW_MISSING_THRESHOLD: 0.6  # Remove rows with > 60% missing

  # Normalization
  SCALER: RobustScaler  # RobustScaler or StandardScaler

# ============================================================================
# GENERAL Configuration
# ============================================================================
# Logging level (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR)
LOG_LVL: 20

# Model selection threshold
THRESHOLD_PERCENTILE: 92  # Top 8% selection

# ============================================================================
# USAGE EXAMPLES
# ============================================================================
#
# 1. First time setup (fetch data):
#    DATA.GET_FMP: Y
#    ML.RUN_REGRESSION: N
#    BACKTEST.RUN_BACKTEST: N
#
# 2. Rebuild VIEW CSVs only (without fetching FMP data):
#    DATA.GET_FMP: N
#    DATA.MAKE_VIEW: Y
#    ML.RUN_REGRESSION: N
#    BACKTEST.RUN_BACKTEST: N
#
# 3. Train ML models:
#    DATA.GET_FMP: N
#    ML.RUN_REGRESSION: Y
#    ML.EXIT_AFTER_ML: Y
#
# 4. Run backtest only:
#    DATA.GET_FMP: N
#    ML.RUN_REGRESSION: N
#    ML.EXIT_AFTER_ML: N
#    BACKTEST.RUN_BACKTEST: Y
#
# 5. Full pipeline:
#    DATA.GET_FMP: Y
#    ML.RUN_REGRESSION: Y
#    ML.EXIT_AFTER_ML: N
#    BACKTEST.RUN_BACKTEST: Y
#
