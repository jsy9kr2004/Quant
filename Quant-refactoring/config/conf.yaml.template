# Quant Trading System Configuration Template
# Copy this file to conf.yaml and fill in your settings

# ============================================================================
# DATA Configuration
# ============================================================================
DATA:
  # Years to process (maximum historical range for comprehensive learning)
  START_YEAR: 1996  # FMP API provides ~30 years of historical data
  END_YEAR: 2025

  # Data root path (will create subdirectories here)
  ROOT_PATH: /home/user/Quant/data

  # FMP API settings
  FMP_URL: https://financialmodelingprep.com
  API_KEY: YOUR_FMP_API_KEY_HERE  # Get from https://site.financialmodelingprep.com/
  EX_SYMBOL: AAPL  # Example symbol used for URL parsing (usually don't need to change)
  TARGET_STOCK_LIST: /home/user/Quant/stocks.csv
  TARGET_API_LIST: data_collector/target_api_list.csv

  # Data collection
  GET_FMP: N  # Y = Fetch new data from FMP, N = Use existing data
  MAKE_VIEW: N  # Y = Rebuild VIEW CSVs from existing data (works even when GET_FMP=N), N = Skip
  STORAGE_TYPE: PARQUET  # PARQUET (recommended) or DB

  # Debug mode removed: SAVE_DEBUG_CSV not used in codebase

# ============================================================================
# ML Configuration
# ============================================================================
ML:
  # Enable ML training
  RUN_REGRESSION: Y  # Y = Train models, N = Skip

  # Training/test split by year
  # Train on maximum historical data for diverse market conditions
  TRAIN_START_YEAR: 1996
  TRAIN_END_YEAR: 2022
  # Test on recent 3 years to validate performance on latest market trends
  TEST_START_YEAR: 2023
  TEST_END_YEAR: 2025

  # NaN removal diagnostics (초기 데이터 품질 확인용)
  EXPORT_NAN_REMOVAL_DETAILS: Y  # Y = 제거된 NaN 데이터를 CSV로 저장, N = 로그만 출력

  # Model selection (use new models or legacy)
  USE_NEW_MODELS: N  # Y = Use new CatBoost/MLflow, N = Use legacy regressor.py

  # Models to train (if USE_NEW_MODELS = Y)
  MODELS:
    - xgboost_default
    - xgboost_depth_9
    - xgboost_depth_10
    - lightgbm_default
    - catboost_default
    - catboost_deep

  # Ensemble removed: Not implemented

  # Hyperparameter optimization (recommended for production)
  USE_OPTUNA: Y  # Y = Auto-tune hyperparameters for optimal performance

  # ===== Classifier Optuna (전체 데이터로 최적화) =====
  # ===== Test Mode (빠른 동작 확인용 - 모델 성능보다 실행 가능 여부 테스트) =====
  OPTUNA_TRIALS: 3  # Minimal trials for quick test
  OPTUNA_CV_FOLDS: 2  # Minimal CV folds
  OPTUNA_TIMEOUT: 300  # 5 minutes limit

  # ===== Production Mode (실전 투자용 - 최고 성능 추구) =====
  # OPTUNA_TRIALS: 50  # Thorough optimization (recommended)
  # OPTUNA_CV_FOLDS: 5  # Full cross-validation
  # OPTUNA_TIMEOUT: null  # No time limit (may take 40-80 hours)

  OPTUNA_SAVE_REPORT: Y  # Y = Save detailed TXT/CSV/JSON reports
  OPTUNA_SAVE_PLOTS: Y  # Y = Save PNG visualization charts

  # Optuna search space (updated for memory safety and overfitting prevention)
  # Based on analysis: max_depth=8, n_estimators=500 prevents memory errors
  OPTUNA_SEARCH_SPACE:
    n_estimators: [100, 500]  # Limited to prevent memory allocation errors
    learning_rate: [0.01, 0.3]  # Minimum 0.01 to avoid extremely slow learning
    max_depth: [3, 8]  # Limited to 8 for memory safety and overfitting prevention
    subsample: [0.5, 1.0]  # Row sampling ratio
    colsample_bytree: [0.5, 1.0]  # Column sampling ratio
    gamma: [0, 10]  # Minimum loss reduction for split

  # ===== Sector-specific Optuna (섹터별 개별 최적화) =====
  OPTUNA_OPTIMIZE_SECTORS: Y  # Y = Optimize each sector separately, N = Use SECTOR_CONFIG only
  OPTUNA_SECTOR_TRIALS: 30  # Trials per sector (less than classifier for efficiency)
  OPTUNA_SECTOR_CV_FOLDS: 2  # CV folds for sector optimization
  OPTUNA_SECTOR_TIMEOUT: 180  # Timeout per sector (3 minutes in test mode)

  # ===== Optuna Result Reuse (결과 재사용) =====
  OPTUNA_REUSE_EXISTING: Y  # Y = Reuse existing results if available, N = Always re-optimize
  OPTUNA_REUSE_MAX_AGE_DAYS: 7  # Maximum age in days for reusing results (0 = always reuse)
  OPTUNA_OUTPUT_DIR: outputs/reports  # Directory for Optuna results (default: outputs/reports)

  # MLflow experiment tracking
  USE_MLFLOW: N  # Y = Track experiments with MLflow
  MLFLOW_EXPERIMENT: quant_trading_v2
  MLFLOW_TRACKING_URI: null  # null for local, or http://server:5000

  # Exit after ML (don't run backtest)
  EXIT_AFTER_ML: Y  # Y = Exit after ML, N = Continue to backtest

  # ============================================================================
  # Sector-based Model Training (섹터별 모델 학습)
  # ============================================================================
  USE_SECTOR_MODEL: Y  # Y = Train separate models per sector for better sector-specific predictions

  # Sector configuration (only used if USE_SECTOR_MODEL = Y)
  SECTOR_CONFIG:
    # Default: Use same model for all sectors (XGBoost)
    # Advanced: Customize model per sector for better performance

    # Example 1: Same model, different parameters per sector
    Technology:
      model: xgboost  # xgboost, lightgbm, catboost
      n_estimators: 200
      max_depth: 8
      learning_rate: 0.05

    Financial:
      model: xgboost
      n_estimators: 150
      max_depth: 6
      learning_rate: 0.1

    Healthcare:
      model: xgboost
      n_estimators: 200
      max_depth: 7
      learning_rate: 0.05

    Consumer:
      model: xgboost
      n_estimators: 150
      max_depth: 6
      learning_rate: 0.1

    Industrial:
      model: xgboost
      n_estimators: 150
      max_depth: 6
      learning_rate: 0.1

    # Example 2: Different models per sector (uncomment to use)
    # Technology:
    #   model: xgboost
    #   n_estimators: 200
    #   max_depth: 8
    #
    # Financial:
    #   model: lightgbm
    #   n_estimators: 150
    #   num_leaves: 31
    #
    # Healthcare:
    #   model: catboost
    #   iterations: 200
    #   depth: 7

# ============================================================================
# BACKTEST Configuration (ML Walk-Forward 백테스트)
# ============================================================================
BACKTEST:
  # Run backtesting
  RUN_BACKTEST: Y  # Y = Run backtest, N = Skip

  # ===== 옵션 1: 여러 구간 백테스트 (권장) =====
  # 서로 다른 시기의 성과를 별도로 측정
  PERIODS:
    # 구간 1: 팬데믹 충격과 유동성 주도 장세
    - START_YEAR: 2020
      END_YEAR: 2021  # 2021.12.31까지 백테스트
      START_MONTH: 1
      START_DATE: 1

    # 구간 2: 금리 급등기와 AI 중심 회복 장세
    - START_YEAR: 2022
      END_YEAR: 2023  # 2023.12.31까지 백테스트
      START_MONTH: 1
      START_DATE: 1

    # 추가 예시: 2024-2025년 백테스트
    # - START_YEAR: 2024
    #   END_YEAR: 2025
    #   START_MONTH: 1
    #   START_DATE: 1

  # ===== 옵션 2: 단일 구간 백테스트 =====
  # PERIODS를 주석 처리하고 아래 사용
  # START_YEAR: 2023
  # END_YEAR: 2024
  # START_MONTH: 3
  # START_DATE: 13

  # 공통 설정
  REBALANCE_PERIOD: 3  # 리밸런싱 주기 (개월)
  TOP_K_NUM: 20        # 선택할 종목 수 (포트폴리오 크기)

  # Reports to generate
  REPORT_LIST:
    - EVAL
    - RANK
    - AI

# ============================================================================
# FEATURE ENGINEERING Configuration
# ============================================================================
FEATURES:
  # Minimum trading volume (percentile) - filters out illiquid stocks
  MIN_VOLUME_PERCENTILE: 50

  # Feature selection thresholds
  MISSING_THRESHOLD: 0.8  # Remove columns with > 80% missing
  SAME_VALUE_THRESHOLD: 0.95  # Remove columns with > 95% same value

  # Preprocessing flags (applied consistently in both regressor and ml_backtest)
  USE_WINSORIZATION: Y  # Y = Apply winsorization to handle outliers
  USE_FEATURE_SELECTION: Y  # Y = Apply feature selection to remove low-quality features

# ============================================================================
# GENERAL Configuration
# ============================================================================
# Logging level (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR)
LOG_LVL: 20

# Model selection threshold
THRESHOLD_PERCENTILE: 92  # Top 8% selection

# ============================================================================
# USAGE EXAMPLES
# ============================================================================
#
# 1. First time setup (fetch data):
#    DATA.GET_FMP: Y
#    ML.RUN_REGRESSION: N
#    BACKTEST.RUN_BACKTEST: N
#
# 2. Rebuild VIEW CSVs only (without fetching FMP data):
#    DATA.GET_FMP: N
#    DATA.MAKE_VIEW: Y
#    ML.RUN_REGRESSION: N
#    BACKTEST.RUN_BACKTEST: N
#
# 3. Train ML models:
#    DATA.GET_FMP: N
#    ML.RUN_REGRESSION: Y
#    ML.EXIT_AFTER_ML: Y
#
# 4. Run backtest only:
#    DATA.GET_FMP: N
#    ML.RUN_REGRESSION: N
#    ML.EXIT_AFTER_ML: N
#    BACKTEST.RUN_BACKTEST: Y
#
# 5. Full pipeline:
#    DATA.GET_FMP: Y
#    ML.RUN_REGRESSION: Y
#    ML.EXIT_AFTER_ML: N
#    BACKTEST.RUN_BACKTEST: Y
#
